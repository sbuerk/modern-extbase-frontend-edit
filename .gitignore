/.DS_Store
/.idea

# Working tree of AI coding agents: plans, reports and scratch files.
# See AGENTS.md — nothing below it is ever committed.
/.agent

# Agent tool configuration and personal, machine-local instructions.
/.claude
/CLAUDE.local.md
/GEMINI.local.md
/AGENTS.local.md

/.Build
/var

# Composer download and phpstan result cache. Deliberately NOT under ".Build/":
# "runTests.sh -s composerUpdate" starts with "rm -rf .Build", which would throw
# the cache away on every dependency install and make caching it in CI pointless.
/.cache

# Intermediates of the frontend asset build. The compiled artifacts below
# "Resources/Public/" are committed, these are not.
#
# "node_modules" is more than a size concern here: "Build/php-cs-fixer/config.php"
# searches "Build/" with "ignoreVCSIgnored()", so this entry is what keeps
# php-cs-fixer out of the PHP files npm packages ship. That config additionally
# excludes the directory by name, because the git based filter needs a checkout.
/Build/node_modules
/Build/.cache

# The Playwright runner of the acceptance suite. A manifest of its own next to
# "Build/package.json" on purpose: the asset build produces committed artifacts,
# and a Playwright bump must not turn into a diff of shipped JavaScript.
/Build/playwright/node_modules

/.direnv
/.envrc

/.php-cs-fixer.cache
/composer.json.orig
/composer.json.testing
/composer.lock

/Documentation-GENERATED-temp

# Generated by the TYPO3 testing framework during functional test runs
/packages

/tailor-version-artefact/
/tailor-version-upload/
