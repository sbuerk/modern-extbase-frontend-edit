{
    "name": "modern-extbase-frontend-edit",
    "description": "Frontend asset build of the modern_extbase_frontend_edit TYPO3 extension.",
    "license": "GPL-2.0-or-later",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24",
        "npm": ">=11"
    },
    "scripts": {
        "build": "node esbuild.mjs",
        "build:dev": "node esbuild.mjs --dev",
        "lint": "cd .. && eslint --config Build/eslint.config.mjs Build/Sources Build/Tests Build/playwright Tests/Acceptance Build/esbuild.mjs Build/eslint.config.mjs",
        "lint:fix": "npm run lint -- --fix",
        "test": "node --import ./Tests/TypeScript/sourceResolve.mjs --test",
        "typecheck": "tsc --noEmit && tsc --noEmit --project Tests/TypeScript/tsconfig.json && tsc --noEmit --project playwright/tsconfig.json"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@types/node": "^24.10.1",
        "esbuild": "^0.25.11",
        "eslint": "^9.39.0",
        "eslint-plugin-lit": "^2.1.1",
        "eslint-plugin-wc": "^3.0.2",
        "globals": "^16.5.0",
        "lit": "^3.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.2"
    }
}
