<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" datatype="plaintext" original="EXT:modern_extbase_frontend_edit/Resources/Private/Language/locallang.xlf" date="2026-08-11T00:00:00Z" product-name="modern_extbase_frontend_edit">
        <header/>
        <body>
            <!--
                Plugin registration. These two pairs are backend labels and
                would usually sit in "locallang_db.xlf"; they live here so that
                the whole plugin surface — its name in the content element
                wizard and every string its templates render — is described in
                one file.
            -->
            <trans-unit id="plugin.list.title">
                <source>Profiles: list</source>
            </trans-unit>
            <trans-unit id="plugin.list.description">
                <source>Lists the profiles of the configured storage page. Each entry links to the detail page, and to the edit page for profiles the logged-in website user owns.</source>
            </trans-unit>
            <trans-unit id="plugin.show.title">
                <source>Profiles: detail</source>
            </trans-unit>
            <trans-unit id="plugin.show.description">
                <source>Renders one profile with its addresses, e-mail addresses and image. The profile is selected by the link the list plugin renders.</source>
            </trans-unit>
            <trans-unit id="plugin.edit.title">
                <source>Profiles: edit</source>
            </trans-unit>
            <trans-unit id="plugin.edit.description">
                <source>Renders the profile of the logged-in website user as an editable surface. It takes no arguments: the record is resolved from the session, so the plugin shows every visitor their own profile and nobody else's.</source>
            </trans-unit>

            <!-- List plugin. -->
            <trans-unit id="list.heading">
                <source>Profiles</source>
            </trans-unit>
            <trans-unit id="list.empty">
                <source>No profiles available.</source>
            </trans-unit>

            <!--
                Edit plugin, the strings its template renders. Everything the
                lit component renders is further down, under "Editing surface".

                The two empty states are separate sentences on purpose: "log in
                first" and "you have no profile yet" are different instructions,
                and one vague sentence covering both would be actionable for
                neither visitor.
            -->
            <trans-unit id="edit.heading">
                <source>Your profile</source>
            </trans-unit>
            <trans-unit id="edit.notLoggedIn">
                <source>You are not logged in. Log in to view and edit your profile.</source>
            </trans-unit>
            <trans-unit id="edit.noProfile">
                <source>There is no profile assigned to your account yet.</source>
            </trans-unit>
            <trans-unit id="edit.workspaceActive">
                <source>Your profile is shown as it appears in this workspace. Editing is only available in the live workspace.</source>
            </trans-unit>

            <!--
                Link labels. Both are rendered by partials that are shared
                between the plugins, so they carry no plugin name.
            -->
            <trans-unit id="link.show">
                <source>View profile</source>
            </trans-unit>
            <trans-unit id="link.edit">
                <source>Edit profile</source>
            </trans-unit>

            <!--
                Profile labels, shared by both plugins. The keys are flat rather
                than prefixed per plugin, because the partials that render them
                are used by the list and by the detail template alike and must
                not know which one called them.

                The labels of the address and e-mail *types* are deliberately
                not repeated here: those are select item labels and are already
                translated in "locallang_db.xlf", keyed
                "tx_modernextbasefrontendedit_domain_model_address.type.<value>"
                and "…_email.type.<value>".
            -->
            <trans-unit id="profile.image.alt">
                <source>Portrait of %s</source>
            </trans-unit>
            <trans-unit id="profile.birthday">
                <source>Birthday</source>
            </trans-unit>
            <trans-unit id="profile.bio">
                <source>Biography</source>
            </trans-unit>
            <trans-unit id="profile.addresses">
                <source>Addresses</source>
            </trans-unit>
            <trans-unit id="profile.emails">
                <source>E-mail addresses</source>
            </trans-unit>

            <!--
                Editing surface.

                These are the strings the lit component renders, and they reach
                it as a JSON map in the "data-labels" attribute rather than as
                markup: the component draws its own controls, so a template
                cannot translate them for it and a literal in a TypeScript file
                would be a string no XLIFF file knows about.

                The "id" of every unit below is the key the component looks up,
                letter for letter, and the same list is spelled in
                "Controller\ProfileEditController::LABEL_KEYS" - which is what
                makes the contract greppable from either side. A key that is
                missing here is not fatal: "model/labels.ts" answers with the
                key itself, so the surface shows "action.save" rather than a
                blank button.

                The keys are structural and are built at runtime from a scope
                and a name, so nothing in the TypeScript build can notice one
                that was never translated:
                    field.<scope>.<name>            fieldLabelKey()
                    choice.<scope>.<field>.<value>  choiceLabelKey()
                    action.<name>                   actionLabelKey()
                    section.<scope>                 sectionLabelKey()
                    state.<name>                    stateLabelKey()
                The scope is part of a field key because "type" exists on both
                child collections and means a different thing in each.
            -->
            <trans-unit id="field.profile.shortname">
                <source>Short name</source>
            </trans-unit>
            <trans-unit id="field.profile.firstname">
                <source>First name</source>
            </trans-unit>
            <trans-unit id="field.profile.lastname">
                <source>Last name</source>
            </trans-unit>
            <trans-unit id="field.profile.birthday">
                <source>Birthday</source>
            </trans-unit>
            <trans-unit id="field.profile.bio">
                <source>Biography</source>
            </trans-unit>
            <trans-unit id="field.address.type">
                <source>Address type</source>
            </trans-unit>
            <trans-unit id="field.address.line1">
                <source>Address line 1</source>
            </trans-unit>
            <trans-unit id="field.address.line2">
                <source>Address line 2</source>
            </trans-unit>
            <trans-unit id="field.email.type">
                <source>E-mail type</source>
            </trans-unit>
            <trans-unit id="field.email.email">
                <source>E-mail address</source>
            </trans-unit>

            <!--
                The accepted values of the two select fields.

                These say the same thing as the TCA select item labels in
                "locallang_db.xlf", which the read partials look up
                dynamically, and that duplication is deliberate but not free:
                an installation overriding only one of the two files makes the
                read view and the editing surface disagree about the same
                value. The alternative - resolving these six keys out of the
                database label file - keeps one source and was rejected because
                the component's label contract would then be spread over two
                files. Revisit it if a third consumer appears.
            -->
            <trans-unit id="choice.address.type.home">
                <source>Home</source>
            </trans-unit>
            <trans-unit id="choice.address.type.work">
                <source>Work</source>
            </trans-unit>
            <trans-unit id="choice.address.type.others">
                <source>Other</source>
            </trans-unit>
            <trans-unit id="choice.email.type.private">
                <source>Private</source>
            </trans-unit>
            <trans-unit id="choice.email.type.business">
                <source>Business</source>
            </trans-unit>
            <trans-unit id="choice.email.type.others">
                <source>Other</source>
            </trans-unit>

            <!--
                Buttons.

                "edit" and "apply" belong to one field, "editRecord" and "save"
                to a whole record. They are worded differently on purpose: the
                two editing modes sit next to each other on the same surface,
                and a user who cannot tell them apart saves one field while
                believing they saved five.
            -->
            <trans-unit id="action.edit">
                <source>Edit</source>
            </trans-unit>
            <trans-unit id="action.apply">
                <source>Apply</source>
            </trans-unit>
            <trans-unit id="action.cancel">
                <source>Cancel</source>
            </trans-unit>
            <trans-unit id="action.editRecord">
                <source>Edit all fields</source>
            </trans-unit>
            <trans-unit id="action.save">
                <source>Save all fields</source>
            </trans-unit>
            <trans-unit id="action.add">
                <source>Add</source>
            </trans-unit>
            <trans-unit id="action.remove">
                <source>Remove</source>
            </trans-unit>
            <trans-unit id="action.moveUp">
                <source>Move up</source>
            </trans-unit>
            <trans-unit id="action.moveDown">
                <source>Move down</source>
            </trans-unit>
            <trans-unit id="action.hide">
                <source>Hide</source>
            </trans-unit>
            <trans-unit id="action.show">
                <source>Show</source>
            </trans-unit>

            <!-- Section headings of the two child collections. -->
            <trans-unit id="section.address">
                <source>Addresses</source>
            </trans-unit>
            <trans-unit id="section.email">
                <source>E-mail addresses</source>
            </trans-unit>

            <!--
                A record state the surface shows and cannot change. It is also
                rendered by the AddressList and EmailList partials, which the
                edit plugin feeds with the collections including the hidden
                records.
            -->
            <trans-unit id="state.hidden">
                <source>Hidden</source>
            </trans-unit>

            <!--
                The image. "field.profile.image" labels the file control and is
                built the same way as every other field label.

                "error.imageNotStored" is shown next to the server's own reason
                when an upload is refused. It exists because a rejected upload
                moves nothing into storage: the file is gone as far as the server
                is concerned, and the surface has to say so rather than look as
                though it is still holding it.
            -->
            <trans-unit id="field.profile.image">
                <source>Portrait</source>
            </trans-unit>
            <trans-unit id="error.imageNotStored">
                <source>The image was not stored. Please choose the file again.</source>
            </trans-unit>

            <!--
                What a failed request says when it is not a validation failure.

                The endpoint's own "message" is written for a developer and is
                deliberately never shown. Only "error.request" has to exist; the
                component prefers "error.request.<status>" when the site
                provides one, and the two below are the failures a person can
                actually act on.
            -->
            <trans-unit id="error.request">
                <source>The change could not be saved. Please try again.</source>
            </trans-unit>
            <trans-unit id="error.request.403">
                <source>Your session has expired. Reload the page and log in again.</source>
            </trans-unit>
            <trans-unit id="error.request.409">
                <source>Records cannot be edited while a workspace is active.</source>
            </trans-unit>

            <!--
                Validation messages.

                These are what a rejected save shows next to the field that was
                rejected, so they address the person filling in the form and say
                what to do, not what the rule is called.

                The placeholders are positional because that is what
                "AbstractValidator::translateErrorMessage()" passes on: "%1$s"
                and "%2$s" are the bounds a length rule was configured with, so
                the number in the sentence cannot drift away from the number the
                rule enforces.

                A length rule that configures both a minimum and a maximum can
                only ever emit its "between" message — "StringLengthValidator"
                selects by which bounds are set, not by which one was violated —
                so a rule with two bounds needs exactly one key here, not two.
            -->
            <trans-unit id="validation.profile.shortname.empty">
                <source>Enter a short name.</source>
            </trans-unit>
            <trans-unit id="validation.profile.shortname.length">
                <source>The short name has to be between %1$s and %2$s characters long.</source>
            </trans-unit>
            <trans-unit id="validation.profile.firstname.tooLong">
                <source>The first name cannot be longer than %1$s characters.</source>
            </trans-unit>
            <trans-unit id="validation.profile.lastname.tooLong">
                <source>The last name cannot be longer than %1$s characters.</source>
            </trans-unit>
            <trans-unit id="validation.profile.birthday.invalid">
                <source>Enter the date of birth as year-month-day, for example 1815-12-10.</source>
            </trans-unit>
            <trans-unit id="validation.profile.bio.tooLong">
                <source>The biography cannot be longer than %1$s characters.</source>
            </trans-unit>
            <trans-unit id="validation.address.type.invalid">
                <source>Choose one of the offered address types.</source>
            </trans-unit>
            <trans-unit id="validation.address.line1.empty">
                <source>Enter the first address line.</source>
            </trans-unit>
            <trans-unit id="validation.address.line1.tooLong">
                <source>The first address line cannot be longer than %1$s characters.</source>
            </trans-unit>
            <trans-unit id="validation.address.line2.tooLong">
                <source>The second address line cannot be longer than %1$s characters.</source>
            </trans-unit>
            <trans-unit id="validation.email.type.invalid">
                <source>Choose one of the offered e-mail types.</source>
            </trans-unit>
            <trans-unit id="validation.email.email.empty">
                <source>Enter an e-mail address.</source>
            </trans-unit>
            <trans-unit id="validation.email.email.invalid">
                <source>Enter a valid e-mail address.</source>
            </trans-unit>
            <trans-unit id="validation.email.email.tooLong">
                <source>The e-mail address cannot be longer than %1$s characters.</source>
            </trans-unit>

            <!--
                Image upload.

                These are what a rejected upload shows, and they are keyed under
                the field name "image" in the 422 body — the model property the
                upload is configured for, which
                "Validation\ProfileImageUploadRules::PROPERTY" spells once for
                both sides.

                None of them carries a placeholder for something the request
                supplied. The core validators do pass the detected MIME type and
                the submitted file extension as message arguments, and a message
                without a conversion specification simply drops them; that is
                deliberate, and it is the same rule the endpoint envelope
                follows — nothing that was refused is echoed back.

                The size and dimension messages do carry "%1$s". That argument
                is the bound the extension configured, never a submitted value,
                and naming the limit is the only way the sentence is actionable.

                Two further validators are enforced by the core whether they are
                configured or not — FileNameValidator and
                FileExtensionMimeTypeConsistencyValidator. Their messages come
                from "EXT:extbase/Resources/Private/Language/locallang.xlf" and
                are not overridden here.
            -->
            <trans-unit id="validation.profile.image.mimeType">
                <source>Choose a JPEG, PNG, GIF or WebP image.</source>
            </trans-unit>
            <trans-unit id="validation.profile.image.extension">
                <source>The file name extension does not match the contents of the file. Choose a JPEG, PNG, GIF or WebP image.</source>
            </trans-unit>
            <trans-unit id="validation.profile.image.tooLarge">
                <source>The image is too large. Choose one of at most %1$s.</source>
            </trans-unit>
            <trans-unit id="validation.profile.image.tooWide">
                <source>The image is too wide. It can be at most %1$s pixels wide.</source>
            </trans-unit>
            <trans-unit id="validation.profile.image.tooTall">
                <source>The image is too tall. It can be at most %1$s pixels high.</source>
            </trans-unit>

            <!--
                Defaults of the two validators this extension adds. A rule set
                normally names a message of its own; these are what is shown
                when it does not.
            -->
            <trans-unit id="validation.choice.invalid">
                <source>Choose one of the offered values.</source>
            </trans-unit>
            <trans-unit id="validation.date.invalid">
                <source>Enter a valid date as year-month-day.</source>
            </trans-unit>
        </body>
    </file>
